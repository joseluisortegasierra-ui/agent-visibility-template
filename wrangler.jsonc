{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jlosic-a2a-federation",
  "main": "./src/federation.mjs",
  "compatibility_date": "2026-11-24",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "FEDERATION_KV",
      "id": "5260a431394b4cffb22da12f4fecee2c"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    "OWNER_CONFIG_URL": "https://raw.githubusercontent.com/joseluisortegasierra-ui/agent-visibility-template/main/config/jlosic-owners.json",
    "CHILD_CONFIG_URL": "https://raw.githubusercontent.com/joseluisortegasierra-ui/agent-visibility-template/main/config/jlosic-children.json",
    "FEDERATION_SOURCES": "[{\"id\":\"agentbazaar\",\"kind\":\"registry\",\"url\":\"https://agentbazaar.tech/explore/agents.json\",\"description\":\"Directorio público A2A\"},{\"id\":\"a2a-traffic\",\"kind\":\"card\",\"url\":\"https://a2atraffic.com/.well-known/agent-card.json\",\"description\":\"Observatorio A2A firmado\"},{\"id\":\"jlosic-colabora\",\"kind\":\"card\",\"url\":\"https://jlosic-colabora.vercel.app/.well-known/agent-card.json\",\"description\":\"Puerta pública JLOSIC\"}]"
  }
}

